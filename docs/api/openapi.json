  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PainIn": {
        "properties": {
          "part": {
            "type": "string",
            "title": "Part"
          },
          "side": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Side"
          },
          "level": {
            "type": "integer",
            "title": "Level",
            "default": 5
          },
          "type": {
            "type": "string",
            "title": "Type",
            "default": "sharp"
          },
          "since": {
            "type": "string",
            "title": "Since",
            "default": ""
          },
          "lang": {
            "type": "string",
            "title": "Lang",
            "default": "hi-IN"
          }
        },
        "type": "object",
        "required": [
          "part"
        ],
        "title": "PainIn"
      },
      "ProfileIn": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "default": ""
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "hi-IN"
          },
          "family_names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Family Names",
            "default": []
          },
          "condition": {
            "type": "string",
            "title": "Condition",
            "default": ""
          },
          "fallback_voice": {
            "type": "string",
            "title": "Fallback Voice",
            "default": "Shivani"
          }
        },
        "type": "object",
        "title": "ProfileIn"
      },
      "SosIn": {
        "properties": {
          "local_lang": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Local Lang"
          }
        },
        "type": "object",
        "title": "SosIn"
      },
      "SpeakIn": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "lang": {
            "type": "string",
            "title": "Lang",
            "default": "hi-IN"
          },
          "remember": {
            "type": "boolean",
            "title": "Remember",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "SpeakIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VisitIn": {
        "properties": {
          "turns": {
            "items": {
              "$ref": "#/components/schemas/VisitTurnIn"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Turns"
          },
          "lang": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lang"
          }
        },
        "type": "object",
        "required": [
          "turns"
        ],
        "title": "VisitIn"
      },
      "VisitTurnIn": {
        "properties": {
          "speaker": {
            "type": "string",
            "enum": [
              "partner",
              "user"
            ],
            "title": "Speaker"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "t": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "T"
          }
        },
        "type": "object",
        "required": [
          "speaker",
          "text"
        ],
        "title": "VisitTurnIn"
      }
    }
  }
}
